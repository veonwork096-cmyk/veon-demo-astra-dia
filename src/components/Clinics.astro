---
import FutureLink from "./FutureLink.astro";
import Icon from "./Icon.astro";
import { phone, emails } from "../data/site";
// W-F013: what the lab offers to clinics and doctors.
const rows = [
  { title: "Власна логістика біоматеріалу", text: "Лабораторія сама доставляє біоматеріал із закладу своїм логістичним сервісом." },
  { title: "Портал MyLab", text: "Лікаря підключають до порталу: замовлення досліджень і перегляд результатів онлайн." },
  { title: "Гнучка система знижок", text: "Умови для закладу-партнера обговорюються під час консультації." },
];
---
<section id="klinikam" class="section clinics on-field" aria-labelledby="klinikam-title">
  <div class="container clinics__grid">
    <div class="clinics__head">
      <h2 id="klinikam-title">Клінікам і лікарям</h2>
      <p class="clinics__lead">Лабораторні дослідження для клінік і лікарів з доставкою біоматеріалу.</p>
      <div class="clinics__contacts">
        <a class="btn btn--paper" href={phone.href}>
          <Icon name="phone" />
          <span><span class="btn__word">Подзвонити </span><span class="btn__num num">{phone.display}</span></span>
        </a>
        <a class="clinics__mail" href={`mailto:${emails.b2b}`}>{emails.b2b}</a>
      </div>
    </div>
    <ul class="clinics__rows" role="list">
      {rows.map((r) => (
        <li>
          <h3>{r.title}</h3>
          <p>{r.text}</p>
        </li>
      ))}
      <li class="clinics__more">
        <FutureLink note="Сторінка для клінік і лікарів з'явиться в повній версії сайту" up>Умови співпраці</FutureLink>
      </li>
    </ul>
  </div>
</section>

<style>
  .clinics { background: var(--color-field); color: var(--color-on-field); }
  .clinics__grid { display: grid; grid-template-columns: minmax(0, 1fr); gap: var(--space-xl); }
  .clinics__head { display: grid; gap: var(--space-md); align-content: start; }
  .clinics__lead { font-size: var(--text-lead); line-height: 1.4; color: var(--color-on-field-muted); max-width: 32ch; }
  .clinics__contacts { display: grid; justify-items: start; gap: var(--space-sm); margin-top: var(--space-sm); }
  .clinics__contacts .btn { width: 100%; }
  .clinics__mail {
    display: inline-flex; align-items: center; min-height: 44px;
    color: var(--color-on-field); font-weight: var(--weight-ui); font-size: var(--text-lead);
    text-decoration: underline; text-decoration-thickness: 2px; text-underline-offset: .2em;
    transition: color var(--dur-fast) var(--ease-out);
  }
  .clinics__mail:hover { color: var(--color-on-field-muted); }
  .clinics__mail:active { color: var(--color-on-field); }

  .clinics__rows { list-style: none; display: grid; gap: var(--space-lg); }
  .clinics__rows li { display: grid; gap: var(--space-xs); align-content: start; }
  .clinics__rows h3 { font-size: var(--text-title); }
  .clinics__rows p { color: var(--color-on-field-muted); max-width: 52ch; }
  .clinics__more :global(.future-link) { color: var(--color-on-field); }

  @media (min-width: 30rem) { .clinics__contacts .btn { width: auto; } }
  @media (min-width: 48rem) and (max-width: 63.99rem) { .clinics__rows { grid-template-columns: repeat(3, minmax(0, 1fr)); column-gap: var(--gutter); } .clinics__more { grid-column: 1 / -1; } }
  @media (min-width: 64rem) {
    .clinics__grid { grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--gutter); }
    .clinics__grid { row-gap: var(--space-2xl); }
    .clinics__head { grid-column: 1 / -1; grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--gutter); align-items: end; }
    .clinics__head h2 { grid-column: 1 / span 5; }
    .clinics__lead { grid-column: 1 / span 5; }
    .clinics__contacts { grid-column: 8 / span 5; grid-row: 1 / span 2; align-self: end; }
    .clinics__rows { grid-column: 1 / -1; grid-template-columns: repeat(3, minmax(0, 1fr)); column-gap: var(--gutter); }
    .clinics__more { grid-column: 1 / -1; }
  }
</style>
