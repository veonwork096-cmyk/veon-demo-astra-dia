---
import FutureLink from "./FutureLink.astro";
import Icon from "./Icon.astro";
import { prices, phone } from "../data/site";
const ORDER_NOTE = "Онлайн-замовлення з'явиться в повній версії сайту";
---
<section id="analizy" class="section prices" data-rec="W-R030" aria-labelledby="analizy-title">
  <div class="container prices__grid">
    <div class="prices__head">
      <h2 id="analizy-title">Ціни на аналізи</h2>
      <p class="lead">Ціна і термін відомі до візиту. Взяття біоматеріалу оплачується окремо.</p>
      <p class="prices__terms">При онлайн-оплаті окремі аналізи дешевші на 5–7&#8239;%.</p>
      <div class="prices__links">
        <FutureLink note="Каталог з'явиться в повній версії сайту">Весь каталог: близько 1300 досліджень</FutureLink>
        <a class="text-link" href={phone.href}>
          <Icon name="phone" />
          Замовити за телефоном
        </a>
      </div>
    </div>

    <ul class="tags" role="list">
      {prices.map((p, i) => (
        <li class="tag" data-reveal style={`--reveal-delay:${i * 80}ms`}>
          <h3 class="tag__name">{p.name}</h3>
          <p class="tag__full">{p.full}</p>
          <div class="tag__price">
            <p class="num"><span class="tag__value">{p.price}</span> <span class="tag__unit">грн</span></p>
            {p.online && <p class="tag__online">при онлайн-оплаті <strong class="num nowrap">{p.online} грн</strong></p>}
          </div>
          <p class="tag__term">{p.term && <>Термін: <strong class="num">{p.term}</strong></>}</p>
          <FutureLink class="tag__order" note={ORDER_NOTE} up>Замовити онлайн</FutureLink>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .prices__grid { display: grid; gap: var(--space-xl); }
  .prices__head { display: grid; gap: var(--space-sm); align-content: start; }
  .prices__head .lead { margin-bottom: var(--space-xs); }
  .prices__terms { font-size: var(--text-md); color: var(--color-text); max-width: 32ch; }
  .prices__links { display: grid; justify-items: start; gap: var(--space-2xs); margin-top: var(--space-xs); }
  .prices__links :global(.future-link) { color: var(--color-primary); }

  .tags { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: var(--space-md); row-gap: var(--space-xs); list-style: none; }
  .tag {
    display: grid; grid-row: span 5; grid-template-rows: subgrid; row-gap: var(--space-xs); margin-bottom: var(--space-lg);
    padding-top: var(--space-md);
    border-top: 3px solid var(--color-text);
  }
  .tag__name { font-size: var(--text-title); }
  .tag__full { color: var(--color-muted); font-size: var(--text-sm); max-width: 30ch; }
  .tag__price {
    font-family: var(--font-display); font-weight: var(--weight-display);
    line-height: 1; padding-block: var(--space-xs);
    color: var(--color-text);
    display: grid; gap: var(--space-xs); align-content: start;
  }
  .tag__online { font-family: var(--font-body); font-weight: var(--weight-body); font-size: var(--text-sm); line-height: 1.3; color: var(--color-muted); }
  .tag__online strong { color: var(--color-primary); font-weight: var(--weight-ui); }
  .tag__value { font-size: var(--text-figure); }
  .tag__unit { font-size: var(--text-title); }
  .tag__term { color: var(--color-muted); font-size: var(--text-sm); }
  .tag__term strong { color: var(--color-text); font-weight: var(--weight-ui); }
  .tag :global(.tag__order) { color: var(--color-primary); justify-self: start; }

  @media (min-width: 48rem) {
    .tags { grid-template-columns: repeat(3, minmax(0, 1fr)); column-gap: var(--gutter); }
    .tag:nth-child(3n) :global(.future-link__note[aria-hidden="true"]) { left: auto; right: 0; }
  }
  @media (min-width: 64rem) {
    .prices__grid { grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--gutter); }
    .prices__head { grid-column: 1 / span 4; }
    .tags { grid-column: 5 / span 8; }
    .tag { padding-top: var(--space-md); }
  }
</style>
